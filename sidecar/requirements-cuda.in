# Source of requirements-cuda.txt. Regenerate the hashed pins for the image (linux x86_64, CPython 3.12) with:
#   uv pip compile --python-platform x86_64-manylinux_2_28 --python-version 3.12 --generate-hashes \
#      --no-strip-extras -o requirements-cuda.txt requirements-cuda.in
# onnxruntime-gpu[cuda,cudnn] pulls the CUDA 13 runtime / cuFFT / cuRAND / NVRTC and cuDNN 9 wheels (~2 GB):
# no system CUDA in the image, the host only needs an NVIDIA driver >= 580 and nvidia-container-toolkit.
numpy==2.5.2
onnx==1.23.2
onnxruntime-gpu[cuda,cudnn]==1.30.0
